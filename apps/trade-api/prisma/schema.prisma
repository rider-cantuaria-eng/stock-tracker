
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // ou outro banco
  url      = env("DATABASE_URL")
}

model Portfolio {
  id           String  @id @default(cuid())
  name         String  @unique
  initialValue Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  trades       Trade[]
}

model Trade {
  id           String   @id @default(cuid())
  ticker       String
  entryPrice   Float
  exitPrice    Float?
  quantity     Int
  date         DateTime
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}